/**
 * Glyph components - thin Icon wrappers carrying SVG paths.
 *
 * Each glyph forwards `@size`, `@color`, `@title`, `@overrides`, plus
 * `...attributes`, to the base `<Icon>`. The default `@title` is set per
 * glyph for screen-reader naming; pass `@title=""` to suppress.
 *
 * Add new glyphs here following the same pattern (template-only TOC).
 */
import type { TOC } from '@ember/component/template-only';
import type { IconOverrides } from './index.gts';
import Icon from './index.gts';

interface GlyphSignature {
  Args: {
    size?: string;
    color?: string;
    title?: string;
    overrides?: IconOverrides;
  };
  Element: SVGSVGElement;
}

// ─── Hide ──────────────────────────────────────────────────────────────────────
export const Hide: TOC<GlyphSignature> = <template>
  <Icon
    @size={{@size}}
    @color={{@color}}
    @title={{if @title @title "Hide"}}
    @overrides={{@overrides}}
    ...attributes
  >
    <path d="M12.81 4.36l-1.77 1.78a4 4 0 00-4.9 4.9l-2.76 2.75C2.06 12.79.96 11.49.2 10a11 11 0 0112.6-5.64zm3.8 1.85c1.33 1 2.43 2.3 3.2 3.79a11 11 0 01-12.62 5.64l1.77-1.78a4 4 0 004.9-4.9l2.76-2.75zm-.25-3.99l1.42 1.42L3.64 17.78l-1.42-1.42L16.36 2.22z" />
  </Icon>
</template>;

